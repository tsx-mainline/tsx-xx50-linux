#!/sbin/openrc-run
# tsx-boot-ok (xx50): mark a good boot for the stock U-Boot.
#
# BOOT_OK_DELAY seconds (default 60) after the start of the default runlevel,
# and only if the panel app or sshd runs, /usr/local/sbin/tsx-boot-ok sets
# boot_retry=8 and golden_boot_retry=0 in the U-Boot env. It writes only
# after a boot from the normal slots, and only when a value differs. Without
# it, U-Boot goes to the golden slots after 10 boots and stays there for 5 of
# every 7 boots. The check runs in the background, so it does not delay the
# boot. The result goes to the system log (tag tsx-boot-ok).
description="Reset the U-Boot retry counters after a good boot"
BOOT_OK_DELAY=${BOOT_OK_DELAY:-60}
depend() { after tsx-panel-app sshd; }
start() {
	ebegin "tsx-boot-ok: check the boot in ${BOOT_OK_DELAY} s"
	( sleep "$BOOT_OK_DELAY"
	  if rc-service tsx-panel-app status >/dev/null 2>&1 || rc-service sshd status >/dev/null 2>&1; then
		/usr/local/sbin/tsx-boot-ok 2>&1 | logger -t tsx-boot-ok
	  else
		logger -t tsx-boot-ok "neither the panel app nor sshd runs: the boot is not marked good"
	  fi ) >/dev/null 2>&1 &
	eend 0
}
