#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Write a kernel (uImage) and a ramdisk (uInitrd) into the raw slots of the
# xx50 boot card, from the running panel.
#
#   tsx-kernel-slots write <uImage> <uInitrd>
#   tsx-kernel-slots promote [--force]
#   tsx-kernel-slots show
#   tsx-kernel-slots sum
#
# The stock U-Boot reads a normal and a golden copy of each (image/mkcard.sh):
#   0x100000  uInitrd, normal slot (1 MiB area, U-Boot reads 384 KiB)
#   0x200000  uInitrd, golden slot
#   0x800000  uImage, normal slot (4 MiB, U-Boot reads 4 MiB)
#   0xC00000  uImage, golden slot
# U-Boot boots the normal slots. After two failed boots it boots the golden
# slots (tsx-boot-ok keeps the retry counters, README.md "Boot path"). So
# the golden slots hold the last kernel that is known to boot.
#
# "write" writes the new files into the normal slots only and reads them
# back. The golden slots do not change. Each file is padded with zeros to its
# slot. Nothing else on the card changes.
#
# "promote" copies the normal slots to the golden slots and reads them back.
# It refuses unless this boot came from the normal slots, tsx-boot-ok marked
# it good, and the normal slots still hold the files of this boot
# ($TSX_RUN/tsx/boot-ok, written by tsx-boot-ok with the "sum" of the
# normal slots at the start of the boot). --force skips these checks.
#
# "show" prints the name in the uImage and uInitrd header of each slot, and
# whether the golden slots hold the same files as the normal slots.
# "sum" prints the sha256 of the normal slots (the 4 MiB kernel area, then the
# 1 MiB ramdisk area).
#
# Checks before the write: the card has the disk id of the image (0x7458a050)
# and no partition below 16 MiB, the uImage is a legacy ARM kernel image of
# at most 4 MiB, the uInitrd is a legacy ramdisk image of at most 384 KiB.
#
# Env: TSX_CARD_DEV  the boot card (default /dev/mmcblk0). A file works too
#                    (host tests).
#      TSX_RUN       the run directory (default /run, host tests).
# Exit status: 0 done, 1 refused or failed (a failed read-back check: run
# the command again before a reboot).
set -eu
PATH=$PATH:/sbin:/usr/sbin
DEV=${TSX_CARD_DEV:-/dev/mmcblk0}
RUN=${TSX_RUN:-/run}
MIB=1048576
DISK_ID=$((0x7458a050))

die() { echo "tsx-kernel-slots: $*" >&2; exit 1; }

# u32be FILE OFFSET: a big-endian 32-bit value.
u32be() {
	set -- $(dd if="$1" bs=1 skip="$2" count=4 2>/dev/null | od -An -v -tu1)
	[ $# -eq 4 ] || { echo 0; return; }
	echo $(($1 * 16777216 + $2 * 65536 + $3 * 256 + $4))
}
# u8 FILE OFFSET
u8() { dd if="$1" bs=1 skip="$2" count=1 2>/dev/null | od -An -tu1 | tr -d ' '; }
# u32le FILE OFFSET
u32le() {
	set -- $(dd if="$1" bs=1 skip="$2" count=4 2>/dev/null | od -An -v -tu1)
	[ $# -eq 4 ] || { echo 0; return; }
	echo $(($1 + $2 * 256 + $3 * 65536 + $4 * 16777216))
}

# check_image FILE TYPE MAX: a legacy U-Boot image (magic 0x27051956) of
# OS Linux (5), ARM (2) and image type TYPE (2 kernel, 3 ramdisk), whose
# header and data fit in MAX bytes.
check_image() {
	[ -f "$1" ] || die "no file $1"
	[ "$(u32be "$1" 0)" -eq $((0x27051956)) ] || die "$1 is not a legacy U-Boot image"
	[ "$(u8 "$1" 28)" = 5 ] && [ "$(u8 "$1" 29)" = 2 ] && [ "$(u8 "$1" 30)" = "$2" ] ||
		die "$1: not a Linux ARM image of type $2"
	_sz=$(wc -c < "$1")
	[ "$_sz" -le "$3" ] || die "$1: $_sz bytes, more than the $3 bytes that U-Boot reads"
	[ $((64 + $(u32be "$1" 12))) -le "$_sz" ] || die "$1: shorter than its header says"
}

check_card() {
	[ -e "$DEV" ] || die "no boot card $DEV"
	[ "$(u32le "$DEV" 440)" -eq "$DISK_ID" ] || die "$DEV does not have the disk id 0x7458a050 of the xx50 card"
	for _n in 0 1 2 3; do
		_start=$(u32le "$DEV" $((446 + _n * 16 + 8)))
		_size=$(u32le "$DEV" $((446 + _n * 16 + 12)))
		[ "$_size" -eq 0 ] || [ "$_start" -ge 32768 ] || die "$DEV: partition $((_n + 1)) starts below 16 MiB"
	done
}

# slot NAME FILE OFFSET AREA: pad FILE to AREA bytes, write it at OFFSET,
# read it back and compare.
slot() {
	_pad=$TMP/$1.pad
	dd if=/dev/zero of="$_pad" bs=$MIB count=$(($4 / MIB)) 2>/dev/null
	dd if="$2" of="$_pad" conv=notrunc 2>/dev/null
	_want=$(sha256sum < "$_pad" | cut -d' ' -f1)
	echo "   $1: write $(wc -c < "$2") bytes at $(printf 0x%X "$3")"
	dd if="$_pad" of="$DEV" bs=$MIB seek=$(($3 / MIB)) conv=notrunc,fsync 2>/dev/null || die "$1: the write failed"
	sync
	# Read the card, not the page cache.
	[ ! -b "$DEV" ] || echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
	_got=$(dd if="$DEV" bs=$MIB skip=$(($3 / MIB)) count=$(($4 / MIB)) 2>/dev/null | sha256sum | cut -d' ' -f1)
	[ "$_got" = "$_want" ] || die "$1: the read-back check failed. Run the command again before a reboot."
	rm -f "$_pad"
}

# area_sum OFFSET BYTES...: sha256 of the card areas, one after the other.
area_sum() {
	{ while [ $# -ge 2 ]; do
		dd if="$DEV" bs=$MIB skip=$(($1 / MIB)) count=$(($2 / MIB)) 2>/dev/null
		shift 2
	done; } | sha256sum | cut -d' ' -f1
}
normal_sum() { area_sum $((0x800000)) $((4 * MIB)) $((0x100000)) $MIB; }
golden_sum() { area_sum $((0xC00000)) $((4 * MIB)) $((0x200000)) $MIB; }

# copy NAME FROM TO AREA: copy a card area to another offset, read it back.
copy() {
	dd if="$DEV" of="$TMP/area" bs=$MIB skip=$(($2 / MIB)) count=$(($4 / MIB)) 2>/dev/null
	[ "$(wc -c < "$TMP/area")" -eq "$4" ] || die "$1: the read of $(printf 0x%X "$2") failed"
	slot "$1" "$TMP/area" "$3" "$4"
}

name_at() {
	if [ "$(u32be "$DEV" "$1")" -eq $((0x27051956)) ]; then
		dd if="$DEV" bs=1 skip=$(($1 + 32)) count=32 2>/dev/null | tr -d '\0'
	else
		echo "(no image)"
	fi
}

case "${1:-}" in
write)
	[ $# -eq 3 ] || die "usage: tsx-kernel-slots write <uImage> <uInitrd>"
	check_image "$2" 2 $((4 * MIB))
	check_image "$3" 3 $((0x300 * 512))
	check_card
	TMP=$(mktemp -d)
	trap 'rm -rf "$TMP"' EXIT
	echo "tsx-kernel-slots: $(dd if="$2" bs=1 skip=32 count=32 2>/dev/null | tr -d '\0') to the normal slots of $DEV"
	slot "uInitrd normal" "$3" $((0x100000)) $MIB
	slot "uImage normal" "$2" $((0x800000)) $((4 * MIB))
	echo "tsx-kernel-slots: done. The new kernel starts at the next boot. The golden"
	echo "slots keep the last good kernel. After good boots, run: tsx-kernel-slots promote"
	;;
promote)
	[ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = --force ]; } || die "usage: tsx-kernel-slots promote [--force]"
	check_card
	if [ "${2:-}" != --force ]; then
		ok=$RUN/tsx/boot-ok
		[ -r "$ok" ] || die "no good boot from the normal slots is known ($ok is missing): nothing copied. tsx-boot-ok marks a boot 60 s after the start."
		want=$(sed -n 's/^slots=//p' "$ok")
		[ -n "$want" ] || die "$ok has no sum of the normal slots: nothing copied"
		[ "$(normal_sum)" = "$want" ] || die "the normal slots changed after the start of this boot: nothing copied. Boot the new kernel first."
	fi
	if [ "$(normal_sum)" = "$(golden_sum)" ]; then
		echo "tsx-kernel-slots: the golden slots already hold the files of the normal slots"
		exit 0
	fi
	TMP=$(mktemp -d)
	trap 'rm -rf "$TMP"' EXIT
	echo "tsx-kernel-slots: copy the normal slots to the golden slots of $DEV"
	copy "uInitrd golden" $((0x100000)) $((0x200000)) $MIB
	copy "uImage golden" $((0x800000)) $((0xC00000)) $((4 * MIB))
	echo "tsx-kernel-slots: done. The golden slots hold $(name_at $((0xC00000)))."
	;;
sum)
	check_card
	normal_sum
	;;
show)
	check_card
	echo "uImage normal  (0x800000): $(name_at $((0x800000)))"
	echo "uImage golden  (0xC00000): $(name_at $((0xC00000)))"
	echo "uInitrd normal (0x100000): $(name_at $((0x100000)))"
	echo "uInitrd golden (0x200000): $(name_at $((0x200000)))"
	if [ "$(normal_sum)" = "$(golden_sum)" ]; then echo "golden = normal: yes"; else echo "golden = normal: no"; fi
	;;
*)
	awk 'NR > 2 && !/^#/ {exit} NR > 2 {sub(/^# ?/, ""); print}' "$0"
	exit 2
	;;
esac
