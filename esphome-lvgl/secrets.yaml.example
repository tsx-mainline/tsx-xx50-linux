# Copy to secrets.yaml (same folder as the YAML) and fill in. Never commit secrets.yaml.
# api_key: 32 random bytes in base64, for example: openssl rand -base64 32
api_key: "<base64 key>"
# A locally administered MAC for the device id in Home Assistant
# (the eth0 MAC of the panel with the first byte set to 02).
mac_address: "02:00:00:00:00:00"
